{
  // `incremental` stays off: its build info stores a declaration signature of
  // every file, and printing better-auth's inferred instance type for
  // src/auth/index.ts overflows the compiler's stack (a type check without it
  // finds no error). Next's build type-checks the same way.
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "target": "ES2017",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "cloudflare-env.d.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
