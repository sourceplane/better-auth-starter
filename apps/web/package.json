{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && opennextjs-cloudflare populateCache local",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare preview",
    "db:migrate:local": "node ../../tooling/migrations/local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@opennextjs/cloudflare": "1.20.11",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-label": "2.1.6",
    "@radix-ui/react-slot": "1.2.2",
    "@radix-ui/react-tabs": "1.1.12",
    "better-auth": "1.7.3",
    "better-auth-cloudflare": "0.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.509.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.9.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "^19",
    "autoprefixer": "10.4.20",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
  }
}
