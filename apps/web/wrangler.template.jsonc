// The source of wrangler.jsonc, which tooling/wire renders from it: from
// wiring.fixture.json for local work (`pnpm run wire:fixture`, committed as
// that render) — and on every Orun lane, once the Terraform roots exist, from
// the wiring documents they lease-publish. Edit this file, never
// wrangler.jsonc. The workers-assets composition deploys one environment per
// job with no wrangler `--env`, so `__ENV__` names the environment this is
// rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-auth-starter-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // better-auth's tables and the generated auth secret — Cloudflare D1.
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "@@wiring(cloudflare-d1/__ENV__:d1_database_name)@@",
      "database_id": "@@wiring(cloudflare-d1/__ENV__:d1_database_id)@@"
    }
  ],
  // better-auth's secondary storage: the sessions — Workers KV.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "@@wiring(cloudflare-kv/__ENV__:app_kv_id)@@"
    }
  ],
  // The files signed-in users upload — Cloudflare R2 (private; the auth API
  // serves them through the download hook).
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "@@wiring(cloudflare-r2/__ENV__:r2_bucket_name)@@"
    }
  ]
}
